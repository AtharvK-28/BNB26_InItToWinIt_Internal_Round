# Copy to services/api/.env. Never commit the real .env.
# Leave local mode for offline development; use cloud for Supabase/Render.
APP_MODE=local
DATABASE_URL=
# Paste the database password here exactly; it overrides the URL password safely.
DATABASE_PASSWORD=
STORAGE_BACKEND=local
SUPABASE_URL=
# Server-only legacy service_role key from Supabase API settings.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=creatorai-media
# Replace with the exact frontend URL for a hosted deployment.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Add your-service.onrender.com when deploying.
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MEDIA_SIGNING_SECRET=
MAX_UPLOAD_MB=40
MAX_CLIP_SECONDS=180
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Free-tier key; keep it server-only. Leave billing disabled for the demo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Run a small DB-backed worker with the API; can be separated later.
ENABLE_DEMO_WORKER=true
MAX_AGENT_STEPS=6
