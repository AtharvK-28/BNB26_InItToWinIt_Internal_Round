# Copy to apps/web/.env.local. Only publishable NEXT_PUBLIC_* values and the
# optional server-only Anthropic key belong here.

# Video pipeline (services/api). "local" = anonymous loopback workspace;
# "cloud" = Supabase sign-in, required for any hosted deployment.
NEXT_PUBLIC_APP_MODE=local
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, server-only. Studio text tools (ideas, scripts, repurposing,
# pitches, contracts, copilot) use Claude when set, and a built-in engine
# otherwise. Video understanding and clip agents run in services/api (Gemini).
ANTHROPIC_API_KEY=
# CREATORAI_AI=local
